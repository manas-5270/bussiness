# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# Leave blank or set to 'memory' to use auto-provisioned in-memory MongoDB for instant zero-config testing
# Or point to a local/Atlas MongoDB instance: mongodb://localhost:27017/budget_optimizer
MONGODB_URI=mongodb://127.0.0.1:27017/business_budget_optimizer

# Security
JWT_SECRET=super_secure_enterprise_jwt_secret_key_2026_nexora
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Default currency
DEFAULT_CURRENCY=INR
